        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}",
        "description": "Sau DELETE, GET phải trả 404 và đăng nhập bằng tài khoản đã xóa phải trả 401."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "pm.sendRequest({",
              "    url: pm.collectionVariables.get(\"baseUrl\") + \"/users/\" + pm.collectionVariables.get(\"userId\"),",
              "    method: \"GET\",",
              "    header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"adminToken\") }",
              "}, function (err, res) {",
              "    pm.test(\"User da xoa tra 404\", function () {",
              "        pm.expect(err).to.eql(null);",
              "        pm.expect(res.code).to.eql(404);",
              "    });",
              "});",
              "pm.sendRequest({",
              "    url: pm.collectionVariables.get(\"baseUrl\") + \"/auth/tokens\",",
              "    method: \"POST\",",
              "    header: { \"Content-Type\": \"application/json\" },",
              "    body: { mode: \"raw\", raw: JSON.stringify({ grantType: \"password\", email: pm.collectionVariables.get(\"testEmail\"), password: \"Test@2026\" }) }",
              "}, function (err, res) {",
              "    pm.test(\"User da xoa khong dang nhap duoc\", function () {",
              "        pm.expect(err).to.eql(null);",
              "        pm.expect(res.code).to.eql(401);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
