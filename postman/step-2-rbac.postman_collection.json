              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "T15 - Go role co hieu luc ngay",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/users/{{managerId}}/roles/{{managerRoleId}}",
        "description": "Super-admin gỡ user-manager; dùng token manager cũ gọi GET /users phải bị 403. Script gán lại role sau khi kiểm tra."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "pm.sendRequest({",
              "    url: pm.collectionVariables.get(\"baseUrl\") + \"/users\",",
              "    method: \"GET\",",
              "    header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"managerToken\") }",
              "}, function (err, res) {",
              "    pm.test(\"Token cu bi tu choi ngay\", function () {",
              "        pm.expect(err).to.eql(null);",
              "        pm.expect(res.code).to.eql(403);",
              "    });",
              "    // Gán lại role để dùng tiếp tài khoản manager ở các ca sau.",
              "    pm.sendRequest({",
              "        url: pm.collectionVariables.get(\"baseUrl\") + \"/users/\" + pm.collectionVariables.get(\"managerId\") + \"/roles/\" + pm.collectionVariables.get(\"managerRoleId\"),",
              "        method: \"PUT\",",
              "        header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"adminToken\") }",
              "    }, function (err, res) {",
              "        pm.test(\"Gan lai role manager\", function () {",
              "            pm.expect(err).to.eql(null);",
              "            pm.expect(res.code).to.eql(204);",
              "        });",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
