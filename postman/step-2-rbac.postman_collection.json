  "item": [
    {
      "name": "T01 - Chua dang nhap",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Ma loi UNAUTHENTICATED\", function () {",
              "    pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHENTICATED\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "T02 - Member xem danh sach",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{memberToken}}"
          }
        ],
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test(\"Ma loi FORBIDDEN\", function () {",
              "    pm.expect(pm.response.json().error.code).to.eql(\"FORBIDDEN\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "T03 - Phan trang",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auditorToken}}"
          }
        ],
        "url": "{{baseUrl}}/users?page=2&limit=3&sort=fullName"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Thong tin phan trang dung\", function () {",
              "    const result = pm.response.json();",
              "    pm.expect(result.meta.page).to.eql(2);",
              "    pm.expect(result.meta.limit).to.eql(3);",
              "    pm.expect(result.meta.totalPages).to.eql(Math.max(1, Math.ceil(result.meta.totalItems / 3)));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "T04 - Tim kiem va loc",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{auditorToken}}"
          }
        ],
        "url": "{{baseUrl}}/users?q=nguyen&status=active"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Chi co user phu hop\", function () {",
              "    const users = pm.response.json().data;",
              "    pm.expect(users.every(u => u.status === \"active\" && /nguyen/i.test(u.fullName + \" \" + u.email))).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
