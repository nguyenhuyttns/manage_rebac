    {
      "name": "T06 - Them nguoi dung",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"fullName\": \"Nguyen Van An\",\n  \"password\": \"Test@2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"userId\", pm.response.json().id);",
              "}",
              "pm.test(\"Co Location, khong co passwordHash\", function () {",
              "    const user = pm.response.json();",
              "    pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/users/\" + user.id);",
              "    pm.expect(Object.hasOwn(user, \"passwordHash\")).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    },
