              "    pm.expect(pm.response.json().error.code).to.eql(\"SELF_ACTION_FORBIDDEN\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "T13 - Gan vai tro hai lan",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}/roles/{{auditorRoleId}}",
        "description": "Gán auditor hai lần cho cùng user. Cả hai lần phải trả 204, vai trò không được trùng."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "pm.sendRequest({",
              "    url: pm.collectionVariables.get(\"baseUrl\") + \"/users/\" + pm.collectionVariables.get(\"userId\") + \"/roles/\" + pm.collectionVariables.get(\"auditorRoleId\"),",
              "    method: \"PUT\",",
              "    header: { Authorization: \"Bearer \" + pm.collectionVariables.get(\"managerToken\") }",
              "}, function (err, res) {",
              "    pm.test(\"Gan lan hai van tra 204\", function () {",
              "        pm.expect(err).to.eql(null);",
              "        pm.expect(res.code).to.eql(204);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "T14 - Gan super-admin vuot quyen",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{managerToken}}"
          }
        ],
        "url": "{{baseUrl}}/users/{{userId}}/roles/{{superAdminRoleId}}"
