{
  "info": {
    "name": "Buoc 1 - Dang nhap",
    "description": "6 trường hợp ở mục 1.10. Chạy lần lượt từ 1 đến 6. Ở ca 2, thử đổi email sai để kiểm tra cùng thông báo với sai mật khẩu. Muốn lấy token của vai trò khác, đổi email/password ở ca 1 rồi Send.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api/v1"
    },
    {
      "key": "email",
      "value": "huy.nd252582m@sis.hust.edu.vn"
    },
    {
      "key": "password",
      "value": "Admin@2026"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Dang nhap dung",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/tokens",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grantType\": \"password\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set(\"token\", pm.response.json().accessToken);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Sai email hoac mat khau",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/tokens",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grantType\": \"password\",\n  \"email\": \"{{email}}\",\n  \"password\": \"Sai@2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Ma loi INVALID_CREDENTIALS\", function () {",
              "    pm.expect(pm.response.json().error.code).to.eql(\"INVALID_CREDENTIALS\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Thieu mat khau",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/tokens",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"grantType\": \"password\",\n  \"email\": \"{{email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test(\"Ma loi VALIDATION_ERROR\", function () {",
              "    pm.expect(pm.response.json().error.code).to.eql(\"VALIDATION_ERROR\");",
              "});",
              "",
              "pm.test(\"Co loi tai o password\", function () {",
              "    pm.expect(pm.response.json().error.details.some(d => d.field === \"password\")).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Chua gui token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Ma loi UNAUTHENTICATED\", function () {",
              "    pm.expect(pm.response.json().error.code).to.eql(\"UNAUTHENTICATED\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Token sai",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}sai"
          }
        ],
        "url": "{{baseUrl}}/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Ma loi INVALID_TOKEN\", function () {",
              "    pm.expect(pm.response.json().error.code).to.eql(\"INVALID_TOKEN\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Xem ho so",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Tra ve 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Co quyen, khong co passwordHash\", function () {",
              "    const user = pm.response.json();",
              "    pm.expect(Array.isArray(user.permissions)).to.eql(true);",
              "    pm.expect(Object.hasOwn(user, \"passwordHash\")).to.eql(false);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
